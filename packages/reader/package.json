{
  "name": "@labshelf/reader",
  "version": "0.1.0",
  "private": true,
  "description": "The LabShelf PDF reader shared by the VS Code and browser extensions: DOM-free protocol and helpers and the reader UI, consumed as TypeScript source and bundled by each host.",
  "scripts": {
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p src/webview/tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@labshelf/core": "workspace:*",
    "pdfjs-dist": "~6.3.289"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^6.0.3"
  },
  "exports": {
    ".": "./src/shared/index.ts",
    "./src/*": "./src/*.ts",
    "./package.json": "./package.json"
  }
}
