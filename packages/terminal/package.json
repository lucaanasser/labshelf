{
  "name": "@labshelf/terminal",
  "version": "0.1.0",
  "private": true,
  "description": "LabShelf in the terminal: a yazi-style paper explorer and CLI over the same local library the VS Code extension uses, with its own Google Drive sync.",
  "type": "module",
  "bin": {
    "labshelf": "./dist/labshelf.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "watch": "node build/build.mjs --watch",
    "typecheck": "tsc --noEmit -p ./",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start": "node dist/labshelf.mjs"
  },
  "dependencies": {
    "@labshelf/core": "workspace:*",
    "@labshelf/reader": "workspace:*",
    "@napi-rs/canvas": "^1.0.9",
    "pdfjs-dist": "~6.3.289",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^6.0.3"
  }
}
