{
  "name": "@labshelf/vscode",
  "displayName": "LabShelf",
  "description": "Local-first research operating system for VS Code.",
  "version": "0.0.1",
  "publisher": "labshelf",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "labshelf.addPaper",
        "title": "Research: Add Paper",
        "category": "LabShelf",
        "icon": "$(file-add)"
      },
      {
        "command": "labshelf.makeSearchable",
        "title": "Research: Make Scanned Paper Searchable (OCR)",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.makeLibrarySearchable",
        "title": "Research: Make All Scanned Papers Searchable (OCR)",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.openPaper",
        "title": "Research: Open Paper",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.openSidebar",
        "title": "Open Sidebar",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.searchLibrary",
        "title": "Research: Search Library",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.generateBibTeX",
        "title": "Research: Generate BibTeX",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.rebuildIndex",
        "title": "Research: Rebuild Index",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.openPaperPdf",
        "title": "Research: Open Paper PDF",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.openPaperFolder",
        "title": "Research: Reveal Paper Folder",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.copyCitation",
        "title": "Research: Copy Citation Key",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.openListTab",
        "title": "Research: Open List Tab",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.newFolder",
        "title": "New Folder",
        "category": "LabShelf",
        "icon": "$(new-folder)"
      },
      {
        "command": "labshelf.newFolderAtRoot",
        "title": "New Folder at Library Root",
        "category": "LabShelf",
        "icon": "$(new-folder)"
      },
      {
        "command": "labshelf.library.refresh",
        "title": "Refresh",
        "category": "LabShelf",
        "icon": "$(refresh)"
      },
      {
        "command": "labshelf.renameFolder",
        "title": "Rename Folder",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.deleteFolder",
        "title": "Delete Folder",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.addPaperHere",
        "title": "Add Paper Here",
        "category": "LabShelf",
        "icon": "$(file-add)"
      },
      {
        "command": "labshelf.openPdfViewer",
        "title": "Research: Open PDF Viewer",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.deletePaper",
        "title": "Research: Remove Paper",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.sync.connect",
        "title": "Sync: Connect to Google Drive",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.sync.now",
        "title": "Sync: Sync Now",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.sync.disconnect",
        "title": "Sync: Disconnect from Google Drive",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.configureLibrary",
        "title": "Configure Library",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.openSettings",
        "title": "Open Settings",
        "category": "LabShelf",
        "icon": "$(gear)"
      },
      {
        "command": "labshelf.collapseAllSections",
        "title": "Collapse All Sections",
        "category": "LabShelf",
        "icon": "$(collapse-all)"
      },
      {
        "command": "labshelf.ai.rebuildIndex",
        "title": "AI: Rebuild Semantic Index",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.ai.searchByClaim",
        "title": "AI: Search by Claim",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.ai.searchByText",
        "title": "AI: Semantic Search",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.ai.openSettings",
        "title": "AI: Open Settings",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.fetchMetadata",
        "title": "Research: Fetch Metadata for Paper"
      },
      {
        "command": "labshelf.resolveMissingMetadata",
        "title": "Research: Resolve Missing Metadata"
      },
      {
        "command": "labshelf.openPaperPdfExternal",
        "title": "Research: Open Paper PDF in Default Viewer",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.exportAnnotations",
        "title": "Research: Export Annotations to Markdown",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.reader.zoomIn",
        "title": "Reader: Zoom In",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.reader.zoomOut",
        "title": "Reader: Zoom Out",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.reader.zoomReset",
        "title": "Reader: Reset Zoom",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.reader.find",
        "title": "Reader: Find in Document",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.reader.historyBack",
        "title": "Reader: Go Back",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.reader.historyForward",
        "title": "Reader: Go Forward",
        "category": "LabShelf"
      },
      {
        "command": "labshelf.reader.toggleSidebar",
        "title": "Reader: Toggle Sidebar",
        "category": "LabShelf"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "labshelfContainer",
          "title": "LabShelf",
          "icon": "media/labshelf.svg"
        }
      ]
    },
    "views": {
      "labshelfContainer": [
        {
          "id": "labshelf.library",
          "name": "Library",
          "type": "tree"
        },
        {
          "id": "labshelf.settings",
          "name": "Settings",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "labshelf.library",
        "contents": "Loading your library\u2026",
        "when": "!labshelf.libraryLoaded"
      },
      {
        "view": "labshelf.library",
        "contents": "No folders yet.\n[New folder](command:labshelf.newFolder)\nYou can also drag PDFs here.",
        "when": "labshelf.libraryLoaded"
      },
      {
        "view": "labshelf.settings",
        "contents": "Drive, sync, LaTeX bridge.\n[Open settings](command:labshelf.openSettings)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "labshelf.addPaper",
          "when": "view == labshelf.library",
          "group": "navigation@1"
        },
        {
          "command": "labshelf.newFolderAtRoot",
          "when": "view == labshelf.library",
          "group": "navigation@2"
        },
        {
          "command": "labshelf.library.refresh",
          "when": "view == labshelf.library",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "labshelf.addPaperHere",
          "when": "view == labshelf.library && viewItem =~ /^labshelf(Folder|Root)$/",
          "group": "inline@1"
        },
        {
          "command": "labshelf.newFolder",
          "when": "view == labshelf.library && viewItem =~ /^labshelf(Folder|Root)$/",
          "group": "1_modify@1"
        },
        {
          "command": "labshelf.renameFolder",
          "when": "view == labshelf.library && viewItem == labshelfFolder",
          "group": "1_modify@2"
        },
        {
          "command": "labshelf.deleteFolder",
          "when": "view == labshelf.library && viewItem == labshelfFolder",
          "group": "1_modify@3"
        }
      ],
      "commandPalette": [
        {
          "command": "labshelf.reader.zoomIn",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.zoomOut",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.zoomReset",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.find",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.historyBack",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.historyForward",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.toggleSidebar",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        }
      ]
    },
    "configuration": {
      "title": "LabShelf",
      "properties": {
        "labshelf.sync.autoSyncIntervalMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Interval between automatic Google Drive syncs, in minutes."
        },
        "labshelf.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the AI subsystem (semantic search, metadata extraction, paraphrase guard)."
        },
        "labshelf.ocr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Read a PDF optically when its text layer is missing or unreadable, so scanned papers and files with damaged fonts still yield metadata. Only runs when the text layer fails."
        },
        "labshelf.ocr.makeSearchable": {
          "type": "boolean",
          "default": true,
          "description": "After importing a scanned paper, read every page and add an invisible text layer so the PDF can be searched (Ctrl+F) and its text selected. The pages themselves are not altered. Runs in the background; requires labshelf.ocr.enabled. When off, scans are still detected and flagged in the library, and can be made searchable from the paper's details."
        },
        "labshelf.ocr.maxPages": {
          "type": "number",
          "default": 150,
          "minimum": 1,
          "description": "Scanned documents with more pages than this are not given a text layer automatically, since each page takes several seconds to read."
        },
        "labshelf.ocr.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "eng"
          ],
          "description": "Tesseract language codes used for OCR, for example [\"eng\", \"por\"]. Language data is downloaded once on first use."
        },
        "labshelf.reader.vimKeys": {
          "type": "boolean",
          "default": false,
          "description": "Enable single-key vim navigation in the PDF reader (j/k, d/u, gg/G, /, n/N, H/L, w, t). Conventional shortcuts stay active."
        },
        "labshelf.reader.defaultZoom": {
          "type": "string",
          "enum": [
            "page-width",
            "page-fit",
            "page-actual",
            "auto"
          ],
          "default": "page-width",
          "description": "Zoom applied when a paper is opened without a stored reading position, and by Reset Zoom."
        },
        "labshelf.reader.toolbarAutoHide": {
          "type": "boolean",
          "default": true,
          "description": "Hide the reader toolbar while scrolling down; it returns on scroll up, when the pointer nears the top, or on keyboard focus."
        },
        "labshelf.reader.restorePosition": {
          "type": "boolean",
          "default": true,
          "description": "Reopen each paper at the page, zoom and sidebar state where it was last read."
        },
        "labshelf.reader.hoverPreviews": {
          "type": "boolean",
          "default": true,
          "description": "Show a preview when hovering a citation, figure, equation, table or section link."
        },
        "labshelf.reader.hoverDelayMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay before a hover preview opens, in milliseconds."
        },
        "labshelf.reader.citationStyle": {
          "type": "string",
          "enum": [
            "pandoc",
            "latex",
            "author-year",
            "citekey"
          ],
          "enumDescriptions": [
            "> quote, then [@key, p. 12]",
            "``quote'' \\cite[p.~12]{key}",
            "\"quote\" (Silva et al., 2021, p. 12)",
            "quote @key"
          ],
          "default": "pandoc",
          "description": "Format used by Copy with Citation in the PDF reader."
        },
        "labshelf.reader.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "Open the reader beside the current editor (split view). When disabled, the reader opens full-width in the active editor group."
        }
      }
    },
    "keybindings": [
      {
        "command": "labshelf.reader.zoomIn",
        "key": "ctrl+=",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+="
      },
      {
        "command": "labshelf.reader.zoomIn",
        "key": "ctrl+shift+=",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+shift+="
      },
      {
        "command": "labshelf.reader.zoomOut",
        "key": "ctrl+-",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+-"
      },
      {
        "command": "labshelf.reader.zoomReset",
        "key": "ctrl+0",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+0"
      },
      {
        "command": "labshelf.reader.find",
        "key": "ctrl+f",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+f"
      },
      {
        "command": "labshelf.reader.historyBack",
        "key": "alt+left",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "alt+left"
      },
      {
        "command": "labshelf.reader.historyForward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "alt+right"
      },
      {
        "command": "labshelf.reader.toggleSidebar",
        "key": "f4",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.reader.historyBack",
        "key": "alt+left",
        "mac": "cmd+[",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.reader.historyForward",
        "key": "alt+right",
        "mac": "cmd+]",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      }
    ]
  },
  "scripts": {
    "compile": "pnpm run build",
    "build": "pnpm run build:host && pnpm run build:webview",
    "build:host": "node build/host.mjs",
    "build:webview": "node build/reader.mjs",
    "watch": "node build/host.mjs --watch",
    "watch:webview": "node build/reader.mjs --watch",
    "dev": "node build/host.mjs --watch & node build/reader.mjs --watch & wait",
    "typecheck": "tsc --noEmit -p ./",
    "vscode:prepublish": "node build/host.mjs --production && node build/reader.mjs --production",
    "lint": "node ../../scripts/run-eslint.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:core": "jest __tests__/core",
    "test:db": "jest __tests__/db",
    "test:storage": "jest __tests__/storage",
    "test:pdf": "jest __tests__/pdf",
    "test:bibtex": "jest __tests__/bibtex",
    "test:commands": "jest __tests__/commands"
  },
  "dependencies": {
    "@labshelf/ai": "workspace:*",
    "@labshelf/core": "workspace:*",
    "@labshelf/reader": "workspace:*",
    "@napi-rs/canvas": "^1.0.9",
    "@thednp/dommatrix": "^3.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~6.3.289",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.98.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^6.0.3"
  }
}