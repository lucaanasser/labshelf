{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "vscode", "jest"],
    "outDir": "out",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // The reader webview's DOM code compiles under its own tsconfig (DOM lib) and
  // is bundled by build/reader.mjs; only its DOM-free logic/ stays in this program.
  "exclude": [
    "node_modules",
    ".vscode-test",
    "src/pdf-viewer/webview/main.ts",
    "src/pdf-viewer/webview/ui/**"
  ]
}
